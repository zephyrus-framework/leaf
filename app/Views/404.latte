{layout 'layouts/landing.latte'}
{var $title = localize('not_found.title')}
{var $notFound = true}

{block head}
<style>
    .error-container { min-height: calc(100vh - 4rem - 200px); display: flex; align-items: center; justify-content: center; padding: 0 1.5rem; }
    .error-code { font-size: 8rem; font-weight: 800; line-height: 1; background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .error-title { font-size: 1.5rem; font-weight: 600; color: var(--text-bright); margin-top: 0.5rem; }
    .error-message { color: var(--text); margin: 0.75rem auto 0; max-width: 28rem; }
    .error-links { margin-top: 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
    .error-link-primary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; background: var(--accent-fill); color: white; border-radius: 0.5rem; font-weight: 500; font-size: 0.875rem; text-decoration: none; transition: background 0.15s; }
    .error-link-primary:hover { background: var(--accent-fill-hover); color: white; }
    .error-locales { margin-top: 1.25rem; display: flex; justify-content: center; gap: 0.5rem 1.25rem; flex-wrap: wrap; font-size: 0.875rem; }
    .error-locales a { color: var(--accent-light); text-decoration: underline; text-underline-offset: 0.2em; }
    .error-locales a:hover { color: var(--text-bright); }
    .error-link-secondary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border: 1px solid var(--border); color: var(--text); border-radius: 0.5rem; font-weight: 500; font-size: 0.875rem; text-decoration: none; transition: border-color 0.15s, color 0.15s; }
    .error-link-secondary:hover { border-color: var(--border-accent); color: var(--text-bright); }
</style>
{/block}

{block content}
<div class="error-container">
    <div class="text-center">
        <div class="error-code">404</div>
        <h1 class="error-title">{localize('not_found.title')}</h1>
        <p class="error-message">{localize('not_found.message')}</p>
        <div class="error-links">
            <a href="{$leafBaseUrl}{$localePrefix}/" class="error-link-primary">{localize('not_found.home')}</a>
        </div>
        <nav n:if="count($supportedLocales) > 1" class="error-locales" aria-label="{localize('not_found.other_languages')}">
            {foreach $supportedLocales as $loc}
            <a n:if="$loc !== $currentLocale" href="{$leafBaseUrl}{$loc === $defaultLocale ? '' : '/' . $loc}/" hreflang="{$loc}" lang="{$loc}">{\Locale::getDisplayLanguage($loc, $loc)|firstUpper}</a>
            {/foreach}
        </nav>
    </div>
</div>
{/block}
