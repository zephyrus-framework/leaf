<div class="search-overlay" id="search-overlay">
    <div class="search-dialog" role="dialog" aria-modal="true" aria-label="{localize('search.label')}">
        <div class="search-input-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
            </svg>
            <input type="text" class="search-input" id="search-input" placeholder="{localize('search.placeholder')}" aria-label="{localize('search.label')}" autocomplete="off" autofocus>
            <button type="button" class="search-close" onclick="closeSearch()" aria-label="{localize('search.close', ['key' => localize('search.escape')])}"><kbd>{localize('search.escape')}</kbd><span class="search-close-text">{localize('search.close_text')}</span></button>
        </div>
        <div class="search-results" id="search-results" data-empty="{localize('search.empty')}" data-no-results="{localize('search.no_results')}">
            <div class="search-empty">{localize('search.empty')}</div>
        </div>
        <div class="search-footer">
            <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> {localize('search.to_navigate')}</span>
            <span><kbd>{localize('search.enter')}</kbd> {localize('search.to_select')}</span>
        </div>
    </div>
</div>
