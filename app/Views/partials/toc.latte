<aside class="docs-toc" n:if="isset($toc) && count($toc) > 0" aria-labelledby="toc-title">
    <div class="toc-wrapper">
        <p class="toc-title" id="toc-title">{localize('toc.title')}</p>
        <ul class="toc-links">
            {foreach $toc as $heading}
            <li class="toc-item{if ($heading['level'] ?? 2) > 2} toc-item-sub{/if}">
                <a href="#{$heading['id']}" class="toc-link">{$heading['text']}</a>
            </li>
            {/foreach}
        </ul>
    </div>
</aside>
